# AWS credentials for the shared read-only aws-cli container (ai-kit-aws-ro).
# Copy to ~/.claude/mcp-env/.aws.env, fill in the key, chmod 600, then run:
#   bash install.sh -a -p standard -y
#
# The live file lives OUTSIDE this repo (~/.claude/mcp-env/) because the kit has a
# public remote. This example file holds no secret and is safe to commit.
#
# Read by `docker --env-file`, so plain KEY=value only: no quotes, no `export`,
# no spaces around the `=`. Quoting a value here passes the quotes to the CLI.
#
# THERE IS NO COMMAND ALLOW-LIST IN FRONT OF THIS KEY. The old MCP server refused
# anything off its read-only list; the official CLI image has no equivalent, so the
# IAM principal behind this key IS the boundary. It must be read-only, and should
# explicitly Deny secretsmanager:GetSecretValue, ssm:GetParameter, s3:GetObject and
# kms:Decrypt if payload reads matter. See docs/aws.md.

# Access key of a DEDICATED read-only IAM user - never a personal login, so CloudTrail
# attributes agent activity separately.
AWS_ACCESS_KEY_ID=your-read-only-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-read-only-secret-access-key-here

# Default region. Anything outside it needs an explicit --region on the command.
AWS_REGION=eu-west-2
