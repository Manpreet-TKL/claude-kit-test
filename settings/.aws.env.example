# AWS credentials for the aws-api-mcp-server stdio MCP server (READ-ONLY).
# Copy to ~/.claude/mcp-env/.aws.env, fill in the key, chmod 600, then run:
#   ./install.sh -a -p standard -y
#
# The live file lives OUTSIDE this repo (~/.claude/mcp-env/) because the kit has a
# public remote. This example file holds no secret and is safe to commit.
# Read-only is enforced by install.sh (READ_OPERATIONS_ONLY=true) and is NOT
# configurable here - and it is only a guard rail. The IAM principal behind this key
# must itself be read-only, and should explicitly Deny secretsmanager:GetSecretValue,
# ssm:GetParameter, s3:GetObject and kms:Decrypt. See docs/aws.md.

# Access key of a DEDICATED read-only IAM user - never a personal login, so CloudTrail
# attributes agent activity separately.
AWS_ACCESS_KEY_ID=your-read-only-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-read-only-secret-access-key-here

# Default region. Anything outside it needs an explicit --region on the command.
AWS_REGION=eu-west-2
