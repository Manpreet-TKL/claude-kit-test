# Codex agent defaults, shared by both Codex entry points:
#   - `bash install.sh -x`        the `codex mcp-server` stdio MCP server
#   - `bash codex-install.sh`     the standalone containerised runner (codex.sh)
#
# Copy to generated/.codex.env and adjust, or just answer the prompts on either
# installer - both write this exact file. Non-interactive runs:
#   bash install.sh -x -p standard -y
#   bash codex-install.sh -q
#
# generated/.codex.env is gitignored (the whole generated/ folder is). This example
# file is safe to commit. NOTE: there is NO secret here - Codex authenticates with
# your ChatGPT login (`codex login`, stored in ~/.codex), not a token in this kit.
#
# The values are applied as `-c key=value` overrides: baked into the MCP server
# registration so every spawned agent inherits them, and passed at launch by
# codex.sh. Edit + re-run the matching installer to change them.

# Model the agents run. Default is the flagship (most capable). Leave it pointed at
# the current best; update when OpenAI ships the next one.
CODEX_MODEL=gpt-5.6-sol

# Reasoning effort: minimal | low | medium | high | xhigh  (xhigh is model-dependent).
CODEX_REASONING_EFFORT=xhigh

# Sandbox the agents' own shell runs in:
#   read-only           - no file writes (agents propose diffs only)
#   workspace-write     - writes within the cwd tree; network OFF (cannot git push)
#   danger-full-access  - no sandbox; throwaway container/VM only
# Applies to a HOST codex run. Under Docker (codex.sh and the containerised MCP
# server) codex's own bwrap sandbox cannot start, so the inner mode is pinned to
# danger-full-access and the CONTAINER is the sandbox: writes are confined to the
# mounted workspace and there are no git credentials, so a push fails auth.
CODEX_SANDBOX=workspace-write

# When codex stops to ask before running a command:
#   untrusted | on-failure | on-request | never
# Used by the standalone runner only - MCP agents are pinned to `never`, since
# there is no human at the other end of a spawned agent to answer the prompt.
CODEX_APPROVAL=on-request
