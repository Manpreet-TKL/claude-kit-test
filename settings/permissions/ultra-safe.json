{
  "defaultMode": "default",
  "allow": [
    "Read",
    "Bash(ls *)",
    "Bash(cat *)",
    "Bash(grep *)",
    "Bash(git status)",
    "Bash(git diff *)",
    "Bash(git log *)",
    "mcp__atlassian",
    "mcp__github",
    "Bash(bash ~/claude-kit/scripts/agent-aws-cli.sh run *)",
    "Bash(~/claude-kit/scripts/agent-aws-cli.sh run *)",
    "Bash(~/claude-kit/install.sh -l *)",
    "Bash(bash ~/claude-kit/install.sh -l *)",
    "Bash(~/claude-kit/codex-install.sh -l)",
    "Bash(bash ~/claude-kit/codex-install.sh -l)"
  ],
  "ask": [
    "Edit",
    "Write",
    "Bash"
  ],
  "deny": [
    "Bash(git push *)",
    "Bash(git commit *)",
    "Bash(aws *)",
    "Bash(docker run * aws-cli *)",
    "Bash(docker exec * ai-kit-aws-ro *)",
    "Read(./.env)",
    "Read(./.env.*)",
    "Read(~/.ssh/**)"
  ]
}
